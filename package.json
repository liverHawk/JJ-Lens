{
	"name": "jj-lens",
	"displayName": "JJ Lens",
	"version": "0.0.1",
	"description": "Browse the Jujutsu (jj) log, inspect changes, and run jj actions from VS Code.",
	"categories": [
		"Other",
		"SCM Providers"
	],
	"keywords": [
		"jj",
		"jujutsu",
		"scm",
		"vcs"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/liverHawk/JJ-Lens.git"
	},
	"publisher": "purple-hawk",
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "pnpm run package-ext",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"package-ext": "rolldown src/extension.ts -o out/extension.js -f cjs -p node -e vscode -m",
		"pretest": "pnpm run compile && pnpm run typecheck && pnpm run lint && pnpm run format:check",
		"lint": "oxlint src",
		"test": "vscode-test",
		"typecheck": "tsgo -p ./ --noEmit",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"package": "vsce package --no-dependencies",
		"release": "bash ./scripts/release.sh"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/vscode": "^1.90.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^4.1.0",
		"ovsx": "^1.3.0",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"rolldown": "^1.2.15",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	},
	"contributes": {
		"commands": [
			{
				"command": "jj-lens.openStudio",
				"title": "Open JJ Lens Studio",
				"category": "JJ Lens",
				"icon": "$(type-hierarchy)"
			},
			{
				"command": "jj-lens.openGuideTopic",
				"title": "Open Guide Topic",
				"category": "JJ Lens"
			},
			{
				"command": "jj-lens.refresh",
				"title": "Refresh",
				"category": "JJ Lens",
				"icon": "$(refresh)"
			},
			{
				"command": "jj-lens.new",
				"title": "New Change",
				"category": "JJ Lens",
				"icon": "$(add)"
			},
			{
				"command": "jj-lens.newMerge",
				"title": "New Merge Change…",
				"category": "JJ Lens",
				"icon": "$(git-merge)"
			},
			{
				"command": "jj-lens.commit",
				"title": "Commit (Describe @ and Start a New Change)…",
				"category": "JJ Lens",
				"icon": "$(check)"
			},
			{
				"command": "jj-lens.edit",
				"title": "Edit (Make Working Copy)…",
				"category": "JJ Lens",
				"icon": "$(target)"
			},
			{
				"command": "jj-lens.describe",
				"title": "Describe…",
				"category": "JJ Lens",
				"icon": "$(edit)"
			},
			{
				"command": "jj-lens.abandon",
				"title": "Abandon…",
				"category": "JJ Lens",
				"icon": "$(trash)"
			},
			{
				"command": "jj-lens.squash",
				"title": "Squash into Parent",
				"category": "JJ Lens",
				"icon": "$(fold-down)"
			},
			{
				"command": "jj-lens.absorb",
				"title": "Absorb into Earlier Changes",
				"category": "JJ Lens",
				"icon": "$(wand)"
			},
			{
				"command": "jj-lens.split",
				"title": "Split by File…",
				"category": "JJ Lens",
				"icon": "$(split-vertical)"
			},
			{
				"command": "jj-lens.duplicate",
				"title": "Duplicate…",
				"category": "JJ Lens"
			},
			{
				"command": "jj-lens.rebase",
				"title": "Rebase…",
				"category": "JJ Lens"
			},
			{
				"command": "jj-lens.parallelize",
				"title": "Parallelize…",
				"category": "JJ Lens"
			},
			{
				"command": "jj-lens.bookmarkSet",
				"title": "Create or Move Bookmark…",
				"category": "JJ Lens",
				"icon": "$(bookmark)"
			},
			{
				"command": "jj-lens.bookmarkDelete",
				"title": "Delete Bookmark…",
				"category": "JJ Lens"
			},
			{
				"command": "jj-lens.copyChangeId",
				"title": "Copy Change ID",
				"category": "JJ Lens"
			},
			{
				"command": "jj-lens.copyCommitId",
				"title": "Copy Commit ID",
				"category": "JJ Lens"
			},
			{
				"command": "jj-lens.gitFetch",
				"title": "Git Fetch",
				"category": "JJ Lens",
				"icon": "$(repo-pull)"
			},
			{
				"command": "jj-lens.gitPush",
				"title": "Git Push",
				"category": "JJ Lens",
				"icon": "$(repo-push)"
			},
			{
				"command": "jj-lens.gitPushRevision",
				"title": "Git Push a Revision…",
				"category": "JJ Lens"
			},
			{
				"command": "jj-lens.undo",
				"title": "Undo Last Operation",
				"category": "JJ Lens",
				"icon": "$(discard)"
			},
			{
				"command": "jj-lens.setRevset",
				"title": "Set Graph Revset…",
				"category": "JJ Lens",
				"icon": "$(filter)"
			},
			{
				"command": "jj-lens.openDiff",
				"title": "Open Changes",
				"category": "JJ Lens"
			},
			{
				"command": "jj-lens.openFile",
				"title": "Open File",
				"category": "JJ Lens",
				"icon": "$(go-to-file)"
			},
			{
				"command": "jj-lens.restoreFile",
				"title": "Discard Changes to File…",
				"category": "JJ Lens",
				"icon": "$(discard)"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "jj-lens",
					"title": "JJ Lens",
					"icon": "resources/icon.svg"
				}
			]
		},
		"views": {
			"jj-lens": [
				{
					"id": "jj-lens.workingCopy",
					"name": "Working Copy (@)",
					"icon": "resources/icon.svg"
				},
				{
					"id": "jj-lens.guide",
					"name": "Quick Actions & Guide",
					"icon": "resources/icon.svg"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "jj-lens.workingCopy",
				"contents": "No Jujutsu repository was found in this workspace.\nRun `jj git init` (or `jj git init --colocate` in a Git repository), then refresh.\n[Refresh](command:jj-lens.refresh)",
				"when": "!jj-lens.hasRepo"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "jj-lens.openGuideTopic",
					"when": "false"
				},
				{
					"command": "jj-lens.openDiff",
					"when": "false"
				},
				{
					"command": "jj-lens.openFile",
					"when": "false"
				},
				{
					"command": "jj-lens.restoreFile",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "jj-lens.describe",
					"when": "view == jj-lens.workingCopy && jj-lens.hasRepo",
					"group": "navigation@1"
				},
				{
					"command": "jj-lens.commit",
					"when": "view == jj-lens.workingCopy && jj-lens.hasRepo",
					"group": "navigation@2"
				},
				{
					"command": "jj-lens.new",
					"when": "view == jj-lens.workingCopy && jj-lens.hasRepo",
					"group": "navigation@3"
				},
				{
					"command": "jj-lens.openStudio",
					"when": "view == jj-lens.workingCopy && jj-lens.hasRepo",
					"group": "navigation@4"
				},
				{
					"command": "jj-lens.refresh",
					"when": "view == jj-lens.workingCopy && jj-lens.hasRepo",
					"group": "navigation@5"
				},
				{
					"command": "jj-lens.squash",
					"when": "view == jj-lens.workingCopy && jj-lens.hasRepo",
					"group": "1_rewrite@1"
				},
				{
					"command": "jj-lens.absorb",
					"when": "view == jj-lens.workingCopy && jj-lens.hasRepo",
					"group": "1_rewrite@2"
				},
				{
					"command": "jj-lens.split",
					"when": "view == jj-lens.workingCopy && jj-lens.hasRepo",
					"group": "1_rewrite@3"
				},
				{
					"command": "jj-lens.undo",
					"when": "view == jj-lens.workingCopy && jj-lens.hasRepo",
					"group": "2_safety@1"
				},
				{
					"command": "jj-lens.gitFetch",
					"when": "view == jj-lens.workingCopy && jj-lens.hasRepo",
					"group": "3_git@1"
				},
				{
					"command": "jj-lens.gitPush",
					"when": "view == jj-lens.workingCopy && jj-lens.hasRepo",
					"group": "3_git@2"
				},
				{
					"command": "jj-lens.openStudio",
					"when": "view == jj-lens.guide",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "jj-lens.describe",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^revision\\.mut/",
					"group": "inline@1"
				},
				{
					"command": "jj-lens.commit",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^revision\\.mut/",
					"group": "inline@2"
				},
				{
					"command": "jj-lens.describe",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^revision\\.mut/",
					"group": "1_change@1"
				},
				{
					"command": "jj-lens.commit",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^revision\\.mut/",
					"group": "1_change@2"
				},
				{
					"command": "jj-lens.new",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^revision\\./",
					"group": "1_change@3"
				},
				{
					"command": "jj-lens.squash",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^revision\\.mut/",
					"group": "2_rewrite@1"
				},
				{
					"command": "jj-lens.absorb",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^revision\\.mut/",
					"group": "2_rewrite@2"
				},
				{
					"command": "jj-lens.split",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^revision\\.mut/",
					"group": "2_rewrite@3"
				},
				{
					"command": "jj-lens.bookmarkSet",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^revision\\./",
					"group": "3_bookmark@1"
				},
				{
					"command": "jj-lens.bookmarkDelete",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^revision\\./",
					"group": "3_bookmark@2"
				},
				{
					"command": "jj-lens.gitPushRevision",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^revision\\./",
					"group": "3_bookmark@3"
				},
				{
					"command": "jj-lens.copyChangeId",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^revision\\./",
					"group": "9_copy@1"
				},
				{
					"command": "jj-lens.copyCommitId",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^revision\\./",
					"group": "9_copy@2"
				},
				{
					"command": "jj-lens.openFile",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^file\\./ && !(viewItem =~ /removed$/)",
					"group": "inline@1"
				},
				{
					"command": "jj-lens.restoreFile",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^file\\.mut/",
					"group": "inline@2"
				},
				{
					"command": "jj-lens.openDiff",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^file\\./",
					"group": "1_file@1"
				},
				{
					"command": "jj-lens.openFile",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^file\\./ && !(viewItem =~ /removed$/)",
					"group": "1_file@2"
				},
				{
					"command": "jj-lens.restoreFile",
					"when": "view == jj-lens.workingCopy && viewItem =~ /^file\\.mut/",
					"group": "2_file@1"
				}
			]
		},
		"configuration": {
			"title": "JJ Lens",
			"properties": {
				"jj-lens.jjPath": {
					"type": "string",
					"default": "jj",
					"scope": "machine-overridable",
					"description": "Path to the jj executable."
				},
				"jj-lens.revset": {
					"type": "string",
					"default": "",
					"description": "Revset shown in the JJ Lens Studio graph. Leave empty to use jj's default (revsets.log)."
				},
				"jj-lens.logLimit": {
					"type": "integer",
					"default": 200,
					"minimum": 1,
					"description": "Maximum number of revisions and operations to load."
				}
			}
		}
	},
	"activationEvents": [
		"workspaceContains:.jj"
	],
	"engines": {
		"vscode": "^1.90.0"
	}
}

{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"curly": "warn",
		"eqeqeq": "warn",
		"no-throw-literal": "warn",
		"unicorn/require-post-message-target-origin": "off"
	},
	"ignorePatterns": ["out", "dist", ".vscode-test"]
}
